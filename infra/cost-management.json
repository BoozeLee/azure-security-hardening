        },
        "filter": "[if(not(equals(parameters('resourceGroupName'), '')), createObject('dimensions', createObject('name', 'ResourceGroupName', 'operator', 'In', 'values', createArray(parameters('resourceGroupName')))), createObject())]",
        "notifications": {
