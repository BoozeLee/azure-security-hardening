      "type": "Microsoft.Security/pricings",
      "apiVersion": "2022-03-01",
      "name": "Containers",
      "properties": {
        "pricingTier": "Standard"
      }
    },
    {
      "condition": "[parameters('enableDefenderForSql')]",
      "type": "Microsoft.Security/pricings",
      "apiVersion": "2022-03-01",
