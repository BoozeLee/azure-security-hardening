{
    // GitHub Copilot Configuration
    "github.copilot.enable": {
        "*": true,
        "plaintext": true,
        "markdown": true,
        "scminput": false,
        "bicep": true,
        "yaml": true,
        "json": true
    },
    
    // Enable Copilot suggestions for all file types in this workspace
    "github.copilot.editor.enableAutoCompletions": true,
    "github.copilot.advanced": {
        "debug.overrideEngine": "copilot-chat",
        "debug.testOverrideProxyUrl": "",
        "debug.filterLogCategories": []
    },
    
    // Azure specific extensions and settings
    "azure.resourceGroups.groupBy": "resourceType",
    "azure.showSignInStatusBar": true,
    "azureTerraform.terminal": "integrated",
    
    // File associations for better Copilot understanding
    "files.associations": {
        "*.bicep": "bicep",
        "*.yaml": "yaml",
        "*.yml": "yaml"
    },
    
    // Language specific settings for Azure development
    "bicep.experimental.languageServer": true,
    "[bicep]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-bicep",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    
    // Enhanced IntelliSense for better context understanding
    "editor.suggest.showStatusBar": true,
    "editor.suggest.preview": true,
    "editor.suggest.shareSuggestSelections": true,
    
    // Workspace specific settings for Azure Security project
    "workbench.colorCustomizations": {
        "titleBar.activeBackground": "#FF6B35",
        "titleBar.activeForeground": "#FFFFFF"
    },
    
    // Security-focused development settings
    "security.workspace.trust.enabled": true,
    "security.workspace.trust.startupPrompt": "always",
    
    // Better search and indexing for large infrastructure projects
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/.azure": true,
        "**/.terraform": true
    }
}